with "config/mlts_config.gpr";
project Mlts is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Mlts_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("mlts.adb");

   package Compiler is
      for Default_Switches ("Ada") use Mlts_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Mlts;
